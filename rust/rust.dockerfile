# syntax=docker/dockerfile:1
# Generated by GLM 5.3 at 2026-11-10T16:00:28Z
# Both stages use the vibe workload's own base (see vibe/vibe.dockerfile in
# sbx-kits-contrib), so the toolchain ships against the libc the runtime has.
ARG BASE_IMAGE=docker/sandbox-templates:shell-docker
FROM ${BASE_IMAGE} AS build
ARG RUST_VERSION=stable
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo

# C toolchain: the template carries no compiler, and rustc calls the system
# cc at link time. Record the package set before/after so the overlay stages
# exactly what apt added, nothing else.
RUN dpkg-query -W -f '${binary:Package}\n' | sort > /tmp/pkgs-before \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential pkg-config \
 && dpkg-query -W -f '${binary:Package}\n' | sort > /tmp/pkgs-after \
 && comm -13 /tmp/pkgs-before /tmp/pkgs-after > /tmp/pkgs-new

RUN <<'EOF'
set -eu
mkdir -p /out
while read -r pkg; do
  dpkg -L "$pkg" | while IFS= read -r f; do
    case "$f" in
      ""|"/"|"./") continue ;;
      /usr/share/doc/*|/usr/share/man/*|/usr/share/locale/*) continue ;;
    esac
    if [ -d "$f" ] && [ ! -L "$f" ]; then
      mkdir -p "/out$f"
    elif [ -e "$f" ] || [ -L "$f" ]; then
      mkdir -p "/out$(dirname "$f")"
      cp -a "$f" "/out$f"
    fi
  done
done < /tmp/pkgs-new
EOF

# Rust, system-wide, shims into /usr/local/bin so no PATH setup is needed.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y \
      --profile minimal --default-toolchain "${RUST_VERSION}" --no-modify-path
RUN cargo --version && rustc --version && gcc --version

# A mixin's image ENV is never the composed image's: static env rides the
# overlay as a profile script, shims as symlinks.
RUN mkdir -p /out/usr/local/bin /out/etc/profile.d \
 && for b in /usr/local/cargo/bin/*; do \
      ln -s "$b" "/out/usr/local/bin/$(basename "$b")"; \
    done \
 && printf 'export RUSTUP_HOME=/usr/local/rustup\nexport CARGO_HOME=/usr/local/cargo\n' \
      > /out/etc/profile.d/rust.sh

FROM scratch
COPY --from=build /out/ /
COPY --from=build /usr/local/rustup /usr/local/rustup
COPY --from=build /usr/local/cargo /usr/local/cargo
